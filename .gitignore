/server/.venv/
/server/cache/
/server/chat_history/
/server/logs/
/server/models/
/server/runtime/
/server/**/__pycache__/
*.pyc

# 不要提交真实密钥：conf.yaml 已用空占位提交，个人本地配置请用本地覆盖
/server/conf.yaml.bak
/server/conf.yaml.backup
/server/conf.yaml.old
